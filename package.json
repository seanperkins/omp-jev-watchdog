{
  "name": "omp-jev-watchdog",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental shadow-only Jev checks for OMP verification and tool-action instructions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanperkins/omp-jev-watchdog.git"
  },
  "type": "module",
  "scripts": {
    "test": "bun test test",
    "check": "oxlint src test scripts && oxfmt --check src test scripts && bun run check:types",
    "check:types": "tsgo --noEmit -p tsconfig.json",
    "replay": "bun scripts/replay.ts"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.2.4",
    "@oh-my-pi/pi-catalog": "18.2.4",
    "@oh-my-pi/pi-coding-agent": "18.2.4",
    "@oh-my-pi/pi-tui": "18.2.4",
    "@oh-my-pi/pi-utils": "18.2.4",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
